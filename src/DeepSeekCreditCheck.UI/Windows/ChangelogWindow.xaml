<Window x:Class="DeepSeekCreditCheck.UI.Windows.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📋 Historie změn — DeepSeek Credit Checker"
        Width="740" Height="600"
        MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        Foreground="#E0E0E0">
    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.75" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Update banner -->
            <RowDefinition Height="*" />    <!-- Content -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="HISTORIE VERZÍ A ZMĚN" FontSize="11" Foreground="#888" FontWeight="Bold" />
                <TextBlock Text="Changelog aplikace" FontSize="20" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,2,0,2" />
                <TextBlock Text="Přehled novinek, vylepšení a úprav v jednotlivých verzích" FontSize="12" Foreground="#999" />
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="CurrentVersionText" Text="v1.10.0" FontSize="13" Foreground="#81C784" 
                       FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,4,0,0" />
        </Grid>

        <!-- Update Success Banner (Zobrazí se po dokončené aktualizaci) -->
        <Border Grid.Row="1" x:Name="UpdateBanner"
                Background="#1B382B" BorderBrush="#2E7D32" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🎉" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="UpdateBannerMessage" Text="Aplikace byla úspěšně aktualizována!"
                           FontSize="13" Foreground="#A5D6A7" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Main FlowDocument ScrollViewer -->
        <Border Grid.Row="2" Background="#161616" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,16">
            <FlowDocumentScrollViewer x:Name="DocumentViewer"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     IsToolBarVisible="False"
                                     Background="Transparent"
                                     Foreground="#E0E0E0">
                <FlowDocument Background="Transparent" Foreground="#E0E0E0" FontFamily="Segoe UI" FontSize="13" PagePadding="16,12">
                    <!-- Bude dynamicky naplněno v kódu -->
                </FlowDocument>
            </FlowDocumentScrollViewer>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="DeepSeek Credit Checker • Open Source"
                       FontSize="11" Foreground="#666" VerticalAlignment="Center" />

            <Button Grid.Column="1" x:Name="CloseButton" Content="Zavřít" Click="CloseButton_Click"
                    Style="{StaticResource ActionBtn}" />
        </Grid>
    </Grid>
</Window>
